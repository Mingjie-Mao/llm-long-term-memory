{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lltm-memory.pages.dev/schemas/legacy-path-map.schema.json",
  "title": "LLTM artifact legacy-path migration map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at_utc", "source_tree_sha256", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "source_tree_sha256": {"$ref": "#/$defs/sha256"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["old_path", "new_path", "sha256", "bytes", "class", "mode", "verified"],
      "properties": {
        "old_path": {"type": "string", "minLength": 1},
        "new_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0},
        "class": {"enum": ["registry", "experiment", "negative-result", "audit", "release"]},
        "mode": {"enum": ["moved", "copied", "alias"]},
        "verified": {"const": true}
      }
    }
  }
}
