__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Datasets are large (hundreds of MB) — downloaded on demand, never committed.
data/

# Memory stores, vector indexes, ingestion checkpoints.
stores/
*.db
*.db-wal
*.db-shm
*.npy

# P6 feature matrices are compact evaluation evidence, not vector indexes.
!results/raw/*.features.npy

# Eval outputs. The per-question JSONL is committed on purpose: it is the evidence
# behind every number in the README, it lets `chronomem eval report` regenerate the
# table without re-spending quota, and at ~30KB per run it costs nothing.
results/cache/
results/labels-*.csv

.env
.DS_Store

# Local dev server config for the preview pane; machine-specific.
.claude/

# Cloudflare Pages deploy cache. Holds the account id and project name — no
# credentials (the OAuth token lives in ~/Library/Preferences/.wrangler), but an
# account id is not something to publish either. `public-demo/` is deliberately NOT
# ignored: it is the deploy source and belongs in the repository.
.wrangler/
node_modules/

# The playground store is throwaway per-session data, and the exported encoder is a
# 87MB build artifact reproducible with demo-api/export_onnx.py.
stores/demo-playground*
demo-api/onnx-encoder/

# dev100's per-question rows, held back until the dev decision is recorded.
#
# The data protocol allows dev100 to be read as aggregate metrics only — "Read
# aggregate metrics and pre-declared slices, nothing else." Sealing exists so that
# reading a single failure takes a deliberate act; publishing the rows to a public
# repository while the decision is still open puts them in PR diffs, the GitHub UI
# and code search, which is the accidental exposure the seal is for.
#
# The cost/latency `*.usage.json` and the audit checkpoints carry no answers, no
# question ids and no verdicts, so they are committed as the evidence of what ran.
# The rows themselves are kept locally and are committed once the arm decision is on
# record — at which point reading them costs nothing, exactly as with heldout100.
results/sealed/**/*.jsonl
