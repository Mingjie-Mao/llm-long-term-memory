# Copy to .env and fill in. .env is gitignored — never commit the real file.
#
#   cp .env.example .env
#
# Free key (no credit card): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides. Defaults are relative to the repo root.
# LLTM_DATA_DIR=data
# LLTM_STORE_DIR=stores
# LLTM_RESULTS_DIR=results

# Trusted tenant identity for the REST API: token:tenant pairs, comma separated.
#
#   LLTM_API_TOKENS=s3cret-a:tenant-a,s3cret-b:tenant-b
#
# Leave unset for open mode, where any caller may name any namespace. Open mode is
# what the research CLI, the inspector and the test suite use; `/healthz` reports it
# as `authenticated_access: false` so a deployment cannot be mistaken for a secured
# one. Never commit a real token — this file is an example, `.env` is gitignored.
LLTM_API_TOKENS=
