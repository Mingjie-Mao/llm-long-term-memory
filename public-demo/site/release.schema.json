{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lltm-memory.pages.dev/release.schema.json",
  "title": "LLTM public release manifest",
  "description": "Every figure the public page shows comes from here, so the page cannot state a number the repository cannot reproduce at the recorded commit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "release",
    "measured_at",
    "result",
    "engineering"
  ],
  "properties": {
    "$schema": {
      "const": "./release.schema.json"
    },
    "schema_version": {
      "const": 2
    },
    "release": {
      "type": "string",
      "minLength": 1
    },
    "measured_at": {
      "type": "string",
      "format": "date"
    },
    "result": {
      "type": "object",
      "description": "One registered, one-shot comparison. Both baselines were run on the same questions in the same protocol.",
      "additionalProperties": false,
      "required": [
        "dataset",
        "questions",
        "accuracy",
        "median_context_tokens",
        "naive_rag_accuracy",
        "naive_rag_median_context_tokens",
        "significant_vs_naive_rag",
        "one_shot",
        "baseline_run_on_heldout"
      ],
      "properties": {
        "dataset": {
          "type": "string",
          "minLength": 1
        },
        "questions": {
          "type": "integer",
          "minimum": 1
        },
        "accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "median_context_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "naive_rag_accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "naive_rag_median_context_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "full_context_accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "full_context_median_context_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "vs_naive_rag_p_value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "significant_vs_naive_rag": {
          "type": "boolean",
          "description": "Whether the headline gap cleared significance on this test. The page must state this alongside the gap."
        },
        "one_shot": {
          "type": "boolean"
        },
        "baseline_run_on_heldout": {
          "type": "boolean"
        }
      }
    },
    "engineering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified_at",
        "measured_tree_sha256",
        "tests",
        "document_checks",
        "line_coverage",
        "ci_platforms"
      ],
      "properties": {
        "verified_at": {
          "type": "string",
          "format": "date"
        },
        "tests": {
          "type": "integer",
          "minimum": 1,
          "description": "Automated tests of the code, passed plus skipped. Schema 1 also counted one case per tracked Markdown document here, so the figure moved when documents were committed; those are `document_checks` from schema 2 on, and the two numbers are not comparable across the version."
        },
        "document_checks": {
          "type": "integer",
          "minimum": 0,
          "description": "Tracked Markdown documents the suite renders and checks. Reported apart from `tests` because it counts what is in the repository, not what is checked about the code."
        },
        "line_coverage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "ci_platforms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "measured_tree_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 over the files that decide these figures (src, tests, pyproject), name and bytes per file. Content-addressed rather than a commit SHA: a commit recorded in this file stops being reachable the moment the commit containing this file is amended, squashed or rebased. Recomputed by public-demo/check_release_figures.py."
        },
        "source_commit_for_reference": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{7,40}$",
          "description": "The commit checked out when the figures were taken. A human pointer only; it may not survive a history rewrite, which is why it is not the record of record."
        }
      }
    },
    "regression": {
      "type": "object",
      "description": "Optional audited regression; result remains the historical frozen one-shot comparison.",
      "additionalProperties": false,
      "required": [
        "experiment",
        "evidence_class",
        "questions",
        "repeats_per_arm",
        "control_correct",
        "candidate_correct",
        "control_accuracy",
        "candidate_accuracy",
        "mean_difference_pp",
        "control_recorded_tokens",
        "candidate_recorded_tokens",
        "reader_rows",
        "grade_rows",
        "gate_passed",
        "gate_path",
        "gate_sha256",
        "audit_path",
        "audit_sha256"
      ],
      "properties": {
        "experiment": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "const": "exposed-regression"
        },
        "questions": {
          "const": 100
        },
        "repeats_per_arm": {
          "const": 3
        },
        "control_correct": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "candidate_correct": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "control_accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "candidate_accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "mean_difference_pp": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "control_recorded_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_recorded_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reader_rows": {
          "const": 600
        },
        "grade_rows": {
          "const": 600
        },
        "gate_passed": {
          "const": true
        },
        "gate_path": {
          "type": "string",
          "minLength": 1
        },
        "gate_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "audit_path": {
          "type": "string",
          "minLength": 1
        },
        "audit_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
