{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lltm-memory.pages.dev/release.schema.json",
  "title": "LLTM public release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "release", "measured_at", "heldout", "engineering"],
  "properties": {
    "$schema": {"const": "./release.schema.json"},
    "schema_version": {"const": 1},
    "release": {"type": "string", "minLength": 1},
    "measured_at": {"type": "string", "format": "date"},
    "heldout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "accuracy",
        "structured_memory_accuracy",
        "raw_archive_recovery_pp",
        "median_context_tokens",
        "whole_transcript_median_tokens",
        "repeats",
        "baseline_run_on_heldout"
      ],
      "properties": {
        "dataset": {"type": "string", "minLength": 1},
        "accuracy": {"type": "number", "minimum": 0, "maximum": 100},
        "structured_memory_accuracy": {"type": "number", "minimum": 0, "maximum": 100},
        "raw_archive_recovery_pp": {"type": "number", "minimum": -100, "maximum": 100},
        "median_context_tokens": {"type": "integer", "minimum": 0},
        "whole_transcript_median_tokens": {"type": "integer", "minimum": 0},
        "repeats": {
          "type": "array",
          "items": {"type": "number", "minimum": 0, "maximum": 100}
        },
        "baseline_run_on_heldout": {"type": "boolean"}
      }
    },
    "engineering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified_at", "source_commit", "tests", "line_coverage", "ci_platforms"],
      "properties": {
        "verified_at": {"type": "string", "format": "date"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "tests": {"type": "integer", "minimum": 1},
        "line_coverage": {"type": "number", "minimum": 0, "maximum": 100},
        "ci_platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
